# 注：2025+ Google AI Studio 生成的 key 以 AQ. 开头（非 AIzaSy）
#     只要来自 aistudio.google.com/apikey 就有效

# ============================================================
# AI Life OS · 环境变量示例
# 复制为 .env.local 后填入真实值
# ============================================================

# ─── Supabase ───────────────────────────────────────────────
# https://supabase.com/dashboard 获取
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxx

# 仅服务端使用（可选）
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Gemini（替代 OpenAI，免费）────────────────────────
# https://aistudio.google.com/apikey  创建
# 每日免费 1500 次生成
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...

# ─── 应用配置（可选）────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://lifeos.icu
